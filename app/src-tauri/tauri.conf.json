{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Embrova",
  "version": "1.4.0",
  "identifier": "io.github.thomasttcryoo.embroiderystudio",
  "build": {
    "beforeDevCommand": "pnpm --filter editor dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter editor build",
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Embrova",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval'",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:17842",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Embrova",
    "copyright": "Embrova contributors; based on Lilo (GPL-3.0)",
    "category": "GraphicsAndDesign",
    "shortDescription": "Offline embroidery design studio",
    "longDescription": "Embrova turns artwork into embroidery with lettering, editing, hoop selection, thread catalogues, simulation and machine-file export. Based on Lilo; licensed under GPL-3.0-only.",
    "fileAssociations": [
      {
        "ext": [
          "lilo"
        ],
        "name": "Compatible embroidery project",
        "description": "Embroidery project (.lilo)",
        "mimeType": "application/x-lilo-project",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "pes",
          "dst",
          "jef",
          "vp3",
          "exp",
          "xxx",
          "u01",
          "pec",
          "hus",
          "vip",
          "tbf"
        ],
        "name": "Embroidery stitch file",
        "description": "Embroidery stitch file",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "startMenuFolder": "Embrova"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "license": "GPL-3.0-only"
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": [],
      "requireSignedVersion": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "embrova"
        ]
      }
    }
  },
  "mainBinaryName": "embrova"
}
